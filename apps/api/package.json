{
  "name": "@nihon/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.7"
  },
  "scripts": {
    "dev": "bun run db:generate && NIHON_DATA_DIR=../../.local/data node --watch src/main.ts",
    "build": "bun run db:generate && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "bun run db:generate && tsc -p tsconfig.json",
    "test": "bun run db:generate && node --test \"src/**/*.test.ts\" \"contract/**/*.test.ts\"",
    "test:container": "docker build --tag nihon-api:test --file Dockerfile ../.. && NIHON_TEST_IMAGE=nihon-api:test node --test test/container.test.ts",
    "contract:generate": "node contract/generate.ts",
    "contract:check": "node contract/generate.ts --check",
    "db:generate": "CHECKPOINT_DISABLE=1 PRISMA_HIDE_UPDATE_MESSAGE=1 prisma generate --no-hints",
    "db:migration": "node prisma/create-migration.ts",
    "bench:persistence": "bun run db:generate && node bench/persistence.ts",
    "bench:accounts": "bun run db:generate && node bench/accounts.ts"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "7.10.1",
    "@prisma/client": "7.10.1",
    "better-sqlite3": "12.11.1",
    "express": "5.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@asteasolutions/zod-to-openapi": "9.1.0",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "prisma": "7.10.1",
    "typescript": "7.0.2"
  }
}
